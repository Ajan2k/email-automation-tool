# ── Database (Supabase PostgreSQL in prod, local Postgres/SQLite in dev) ──
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/email_platform

# ── Redis (queue) ──
REDIS_URL=redis://localhost:6379/0

# ── SMTP ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=you@yourdomain.com
SMTP_FROM_NAME=Your Name
SMTP_USE_TLS=true

# ── Auth ──
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── LLM ──
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ── Supabase (optional, if using Supabase Auth/Storage) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Tracking ──
PUBLIC_API_URL=http://localhost:8000

# ── Observability ──
SENTRY_DSN=

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000
